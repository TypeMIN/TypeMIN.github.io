---
import { getCollection } from 'astro:content';
import DevLayout from '../../layouts/DevLayout.astro';

const entries = (await getCollection('dev', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projects = entries.filter(e => e.data.type === 'project');
const posts    = entries.filter(e => e.data.type !== 'project');

const STATUS_COLOR: Record<string, string> = {
  active:   '#28c840',
  wip:      '#febc2e',
  archived: '#666',
};
---

<DevLayout title="dev — TypeMIN" description="개발, 자동화, 실험 기록.">
  <div class="page container">

    <header class="page-header">
      <p class="brand-label">development</p>
      <h1>dev</h1>
      <p class="page-header__desc">개발, 자동화, 테스트, AI 실험을 공개 가능한 범위에서 정리합니다.</p>
    </header>

    <!-- ── 프로젝트 카드 그리드 ── -->
    {projects.length > 0 && (
      <section class="section" aria-label="projects">
        <div class="section-head">
          <span class="section-label">projects</span>
          <span class="section-rule" aria-hidden="true"></span>
          <span class="section-count">{String(projects.length).padStart(2, '0')}</span>
        </div>

        <div class="project-grid">
          {projects.map(entry => (
            <a href={`/dev/${entry.id}`} class="project-card">
              <div class="project-card__top">
                <span
                  class="status-dot"
                  style={`background: ${STATUS_COLOR[entry.data.status ?? 'active'] ?? STATUS_COLOR.active}`}
                  title={entry.data.status ?? 'active'}
                  aria-label={entry.data.status ?? 'active'}
                ></span>
                <span class="project-card__category">{entry.data.category}</span>
              </div>

              <h2 class="project-card__name">{entry.data.title}</h2>
              <p class="project-card__desc">{entry.data.description}</p>

              {entry.data.stack.length > 0 && (
                <div class="stack-badges">
                  {entry.data.stack.map(s => <span class="stack-badge">{s}</span>)}
                </div>
              )}

              <div class="project-card__actions">
                {entry.data.demo && (
                  <span class="btn-demo" aria-label="Demo">
                    Demo
                    <svg viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="M1 9L9 1M9 1H3M9 1v6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </span>
                )}
                {entry.data.repo && (
                  <span class="btn-ghost">GitHub</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ── 터미널 포스트 목록 ── -->
    <section class="section" aria-label="posts">
      <div class="section-head">
        <span class="section-label">notes</span>
        <span class="section-rule" aria-hidden="true"></span>
        <span class="section-count">{String(posts.length).padStart(2, '0')}</span>
      </div>

      <div class="terminal">
        <div class="terminal__bar">
          <span class="terminal__dot" style="background:#ff5f57"></span>
          <span class="terminal__dot" style="background:#febc2e"></span>
          <span class="terminal__dot" style="background:#28c840"></span>
          <span class="terminal__path">~/dev/notes — {posts.length} entries</span>
        </div>

        <div class="terminal__body">
          {posts.length === 0 ? (
            <p class="terminal__empty">
              <span class="prompt">$</span>
              <span class="cmd blink">▌</span>
            </p>
          ) : posts.map((entry, i) => (
            <a href={`/dev/${entry.id}`} class="entry-row">
              <span class="prompt">$</span>
              <span class="entry-row__idx">{String(i + 1).padStart(2, '0')}</span>
              <div class="entry-row__main">
                <div class="entry-row__top">
                  <span class="cmd">{entry.data.title.replace(/ /g, '_').toLowerCase()}</span>
                  <div class="tags">
                    {entry.data.tags?.map(t => <code>[{t}]</code>)}
                  </div>
                </div>
                <p class="entry-row__desc">{entry.data.description}</p>
              </div>
              <time class="entry-row__date" datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </time>
            </a>
          ))}

          <div class="terminal__cursor" aria-hidden="true">
            <span class="prompt">$</span>
            <span class="blink">▌</span>
          </div>
        </div>
      </div>
    </section>

  </div>
</DevLayout>

<style>
  /* v2 */
  .page {
    padding-top: clamp(3.5rem, 9vw, 6rem);
    padding-bottom: 7rem;
  }

  .page-header { margin-bottom: 3rem; }

  .brand-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-accent);
    margin-bottom: 0.8rem;
  }

  h1 {
    font-family: var(--font-mono);
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 1rem;
  }

  .page-header__desc {
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.75;
    margin: 0;
  }

  /* ── 섹션 헤더 ── */
  .section { margin-bottom: 3rem; }

  .section-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    white-space: nowrap;
  }

  .section-rule { flex: 1; height: 1px; background: var(--border); }

  .section-count {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    color: var(--brand-accent);
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  /* ── 프로젝트 카드 그리드 ── */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-1);
    color: var(--text-primary);
    text-decoration: none;
    transition: border-color 0.18s, background 0.18s, transform 0.18s;
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--brand-accent);
    opacity: 0;
    transition: opacity 0.18s;
  }

  .project-card:hover {
    border-color: var(--brand-accent);
    background: var(--bg-2);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .project-card:hover::before { opacity: 1; }

  [data-theme="dark"] .project-card {
    background: #0a0e14;
    border-color: rgba(120, 160, 255, 0.12);
  }

  [data-theme="dark"] .project-card:hover {
    background: #111620;
    border-color: var(--brand-accent);
  }

  .project-card__top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-card__category {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .project-card__name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }

  .project-card:hover .project-card__name { color: var(--brand-accent); }

  .project-card__desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .stack-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.2rem;
  }

  .stack-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--brand-accent);
    background: color-mix(in srgb, var(--brand-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand-accent) 25%, transparent);
    border-radius: 3px;
    padding: 2px 6px;
  }

  .project-card__actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
    flex-wrap: wrap;
  }

  .btn-demo,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 4px 10px;
    border-radius: 4px;
    border: 1px solid var(--brand-accent);
    transition: background 0.15s, color 0.15s;
  }

  .btn-demo {
    background: var(--brand-accent);
    color: #fff;
  }

  .project-card:hover .btn-demo {
    background: color-mix(in srgb, var(--brand-accent) 85%, #000);
  }

  .btn-demo svg { width: 9px; height: 9px; }

  .btn-ghost {
    background: transparent;
    color: var(--brand-accent);
  }

  .project-card:hover .btn-ghost {
    background: color-mix(in srgb, var(--brand-accent) 10%, transparent);
  }

  /* ── 터미널 (posts) ── */
  .terminal {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-1);
  }

  [data-theme="dark"] .terminal {
    background: #0a0e14;
    border-color: rgba(120, 160, 255, 0.12);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-2);
    border-bottom: 1px solid var(--border);
  }

  [data-theme="dark"] .terminal__bar {
    background: #111620;
    border-color: rgba(120, 160, 255, 0.10);
  }

  .terminal__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .terminal__path {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    margin-left: 0.5rem;
  }

  .terminal__body { padding: 1rem 0; }

  .entry-row {
    display: grid;
    grid-template-columns: 1.4rem 2.8rem 1fr 9rem;
    gap: 0 0.75rem;
    align-items: start;
    padding: 0.85rem 1.25rem;
    color: var(--text-primary);
    text-decoration: none;
    position: relative;
    transition: background 0.15s;
  }

  .entry-row:hover { background: var(--bg-2); text-decoration: none; }

  [data-theme="dark"] .entry-row:hover { background: rgba(120, 160, 255, 0.06); }

  .prompt {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--brand-accent);
    user-select: none;
    line-height: 1.6;
  }

  .entry-row__idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-tertiary);
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .entry-row__top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }

  .cmd {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color 0.15s;
    letter-spacing: -0.01em;
  }

  [data-theme="dark"] .cmd { color: #88c4f0; }

  .entry-row:hover .cmd { color: var(--brand-accent); }

  [data-theme="dark"] .entry-row:hover .cmd { color: #a8d8f8; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }

  .tags code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    background: none;
    border: none;
    padding: 0;
    letter-spacing: 0.02em;
    transition: color 0.15s;
  }

  [data-theme="dark"] .tags code { color: #5a7a9a; }
  .entry-row:hover .tags code { color: var(--brand-accent); }

  .entry-row__desc {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  [data-theme="dark"] .entry-row__desc { color: #5a7060; }

  .entry-row__date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-tertiary);
    text-align: right;
    letter-spacing: 0.02em;
    padding-top: 0.2rem;
  }

  .terminal__cursor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-tertiary);
  }

  .blink {
    animation: blink 1.1s step-end infinite;
    color: var(--brand-accent);
    font-weight: 700;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .terminal__empty { padding: 0.5rem 1.25rem; }

  @media (max-width: 600px) {
    .entry-row { grid-template-columns: 1.4rem 1fr; }
    .entry-row__idx, .entry-row__date { display: none; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
