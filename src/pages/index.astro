---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';
const featured = (await getProjects()).filter((project) => project.data.featured).slice(0, 8);
const emptySlots = Array.from({ length: 8 - featured.length }, (_, index) => featured.length + index + 1);
---
<BaseLayout>
  <header class="home-intro"><p class="eyebrow"><span class="small-dot" aria-hidden="true"></span> PROJECTS & EXPERIENCES</p><h1>{site.headline}<span class="brand-dot">.</span></h1><p>{site.introduction}</p></header>

  <section class="home-projects" aria-labelledby="featured-title">
    <div class="home-section-heading"><div><p class="eyebrow">SELECTED PROJECTS</p><h2 id="featured-title">대표 프로젝트</h2></div><a href="/webapp-projects/" class="text-link">웹앱 전체 보기 <Arrow /></a></div>
    <div class="featured-grid">
      {featured.map((project, index) => <FeaturedProject project={project} index={index} />)}
      {emptySlots.map((number) => <div class="project-placeholder"><div class="placeholder-top"><span class="mono">{String(number).padStart(2, '0')}</span><span class="eyebrow">COMING SOON</span></div><span class="placeholder-plus" aria-hidden="true">+</span><h3>준비 중</h3><p>새로운 프로젝트가 들어올 자리입니다.</p></div>)}
    </div>
  </section>

  <section class="home-about" aria-labelledby="intro-title"><div><p class="eyebrow">A LITTLE ABOUT ME</p><h2 id="intro-title">안녕하세요, TypeMIN입니다<span class="brand-dot">.</span></h2><p>{site.shortAbout}</p></div><div class="home-about-links"><a href="/portfolio/" class="button">포트폴리오 보기 <Arrow /></a><a href="/about/" class="text-link">소개 더 보기 <Arrow /></a></div></section>
</BaseLayout>
