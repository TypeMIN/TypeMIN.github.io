---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['전체', 'dev', 'photo', 'music', 'writing', 'essay'] as const;
const catLabel: Record<string, string> = { dev: 'Dev', photo: 'Photo', music: 'Music', writing: 'Writing', essay: 'Essay' };
---

<BaseLayout title="글 — TypeMIN" description="TypeMIN의 개발, 사진, 음악, 글 모음">
  <div class="container" style="padding-top: 2.5rem; padding-bottom: 3rem;">
    <h1 class="page-title">글</h1>

    <div class="filter-row" role="group" aria-label="카테고리 필터">
      {categories.map(cat => (
        <button class={`filter-btn ${cat === '전체' ? 'active' : ''}`} data-cat={cat}>
          {cat === '전체' ? '전체' : catLabel[cat]}
        </button>
      ))}
    </div>

    <div class="post-list" id="post-list">
      {sorted.map(post => (
        <div class="post-item" data-cat={post.data.category}>
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            category={post.data.category}
          />
        </div>
      ))}
    </div>

    <p class="empty-state" id="empty-state" style="display:none">
      아직 이 카테고리의 글이 없어요.
    </p>
  </div>
</BaseLayout>

<script is:inline>
  var params = new URLSearchParams(window.location.search);
  var initCat = params.get('cat') || '전체';

  function filter(cat) {
    var items = document.querySelectorAll('.post-item');
    var btns = document.querySelectorAll('.filter-btn');
    var empty = document.getElementById('empty-state');
    var visible = 0;

    btns.forEach(function(b) { b.classList.toggle('active', b.dataset.cat === cat); });

    items.forEach(function(item) {
      var show = cat === '전체' || item.dataset.cat === cat;
      item.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    empty.style.display = visible === 0 ? '' : 'none';
  }

  document.querySelectorAll('.filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() { filter(btn.dataset.cat); });
  });

  filter(initCat);
</script>

<style>
  .page-title { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: var(--text-primary); }

  .filter-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; }

  .filter-btn {
    font-size: 0.8rem; font-weight: 500; padding: 5px 14px;
    border-radius: 99px; border: 0.5px solid var(--border);
    background: transparent; color: var(--text-secondary);
    cursor: pointer; font-family: var(--font-sans);
    transition: all 0.15s;
  }
  .filter-btn:hover { background: var(--bg-2); color: var(--text-primary); }
  .filter-btn.active { background: var(--cobalt); color: #EEF0FA; border-color: var(--cobalt); }

  .post-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .empty-state { text-align: center; padding: 3rem 0; color: var(--text-tertiary); font-size: 0.9rem; }
</style>
