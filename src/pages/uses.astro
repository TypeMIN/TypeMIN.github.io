---
import TypeminLayout from '../layouts/TypeminLayout.astro';

const groups = [
  ['Computer', ['MacBook', 'iPad', 'VS Code', 'GitHub']],
  ['Photo', ['Nikon Z50II', 'NIKKOR Z 26mm f/2.8']],
  ['Software', ['Astro', 'TypeScript', 'Markdown', 'GitHub Actions']],
];
---

<TypeminLayout title="Uses — TypeMIN" description="TypeMIN이 사용하는 장비와 작업 환경">
  <main class="container container--reading uses-page">
    <p class="section-label">Uses</p>
    <h1>작업 환경과 도구</h1>
    <p class="lead">현재 사용하는 장비, 소프트웨어, 작업 환경을 정리하는 페이지입니다.</p>

    <div class="uses-list">
      {groups.map(([group, items]) => (
        <section class="uses-group">
          <h2>{group}</h2>
          <ul>
            {(items as string[]).map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </main>
</TypeminLayout>

<style>
  .uses-page {
    padding-bottom: 4rem;
    padding-top: 4rem;
  }

  .uses-page h1 {
    color: var(--text-primary);
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    margin: 0 0 1rem;
  }

  .lead {
    color: var(--text-secondary);
    line-height: 1.75;
  }

  .uses-list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .uses-group {
    border-top: 0.5px solid var(--border);
    padding-top: 1rem;
  }

  .uses-group h2 {
    color: var(--text-primary);
    font-size: 1rem;
    margin: 0 0 0.8rem;
  }

  .uses-group ul {
    color: var(--text-secondary);
    display: grid;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
  }
</style>
