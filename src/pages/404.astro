---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — TypeMIN" description="페이지를 찾을 수 없어요">
  <div class="container" style="padding-top: 6rem; padding-bottom: 6rem; text-align: center;">
    <p class="code">404</p>
    <h1 class="title">페이지를 찾을 수 없어요</h1>
    <p class="desc">요청하신 페이지가 없거나 이동됐을 수 있어요.</p>
    <a href="/" class="btn btn--primary" style="margin-top: 1.5rem;">홈으로 돌아가기</a>
  </div>
</BaseLayout>

<style>
  .code { font-size: 4rem; font-weight: 700; color: var(--cobalt-light); opacity: 0.4; line-height: 1; margin-bottom: 0.5rem; font-family: var(--font-mono); }
  .title { font-size: 1.5rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.5rem; }
  .desc { font-size: 0.9rem; color: var(--text-secondary); }
</style>
