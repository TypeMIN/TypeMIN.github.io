---
import { getCollection } from 'astro:content';
import KineMilesLayout from '../../layouts/KineMilesLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import PhotoMap from '../../components/PhotoMap.astro';

const entries = (await getCollection('photo', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const items = entries.map((e) => ({
  href: `/kine.miles/${e.id}`,
  title: e.data.title,
  description: e.data.description,
  cover: e.data.cover,
  date: e.data.date,
  meta: [e.data.location, e.data.camera].filter(Boolean).join(' · '),
  tags: e.data.tags,
}));

const shotCount = String(entries.length).padStart(4, '0');

const mapMarkers = entries
  .filter(e => e.data.lat != null && e.data.lng != null)
  .map(e => ({
    lat: e.data.lat!,
    lng: e.data.lng!,
    title: e.data.title,
    href: `/kine.miles/${e.id}`,
    location: e.data.location,
  }));
---

<KineMilesLayout title="kine.miles — photo" description="시리즈 단위의 사진 아카이브.">

  <div class="page container">

    <!-- 뷰파인더 헤더 -->
    <div class="viewfinder">
      <!-- 코너 브라켓 -->
      <span class="vf-corner vf-corner--tl" aria-hidden="true"></span>
      <span class="vf-corner vf-corner--tr" aria-hidden="true"></span>
      <span class="vf-corner vf-corner--bl" aria-hidden="true"></span>
      <span class="vf-corner vf-corner--br" aria-hidden="true"></span>

      <!-- 상단 상태 바 -->
      <div class="vf-status vf-status--top">
        <span class="vf-badge">A</span>
        <span class="vf-sep">·</span>
        <span>f/1.8</span>
        <span>1/250</span>
        <span>ISO 400</span>
        <span class="vf-spacer"></span>
        <span class="vf-rdy">● REC</span>
      </div>

      <!-- 중앙 콘텐츠 -->
      <div class="vf-body">
        <div class="vf-crosshair" aria-hidden="true">
          <span></span><span></span>
        </div>
        <div class="vf-info">
          <p class="vf-brand">kine.miles</p>
          <p class="vf-desc">사진을 흩어두기보다 시리즈 단위로 정리하는 이미지 아카이브.</p>
        </div>
      </div>

      <!-- 하단 상태 바 -->
      <div class="vf-status vf-status--bottom">
        <span class="vf-shot">{shotCount}</span>
        <span class="vf-sep">·</span>
        <span>{entries.length} {entries.length === 1 ? 'series' : 'series'}</span>
        <span class="vf-spacer"></span>
        <span class="vf-af">AF-C</span>
        <span class="vf-sep">·</span>
        <span class="vf-wb">AWB</span>
        <span class="vf-sep">·</span>
        <span class="vf-fmt">RAW+J</span>
      </div>
    </div>

    {mapMarkers.length > 0 && <PhotoMap markers={mapMarkers} />}

    <PhotoGrid items={items} />

    {items.length === 0 && (
      <p class="empty">아직 기록된 사진 시리즈가 없습니다.</p>
    )}

  </div>
</KineMilesLayout>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 6rem;
  }

  /* ── 뷰파인더 ── */
  .viewfinder {
    position: relative;
    border: 1px solid var(--border);
    background: var(--bg-1);
    margin-bottom: 0;
    padding: 0;
    overflow: hidden;
  }

  [data-theme="dark"] .viewfinder {
    background: #0e1014;
    border-color: rgba(255, 255, 255, 0.08);
  }

  /* 코너 브라켓 — 뷰파인더의 사각 마커 */
  .vf-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    z-index: 2;
  }

  .vf-corner--tl { top: 8px;    left: 8px;    border-top: 2px solid var(--brand-accent); border-left: 2px solid var(--brand-accent); }
  .vf-corner--tr { top: 8px;    right: 8px;   border-top: 2px solid var(--brand-accent); border-right: 2px solid var(--brand-accent); }
  .vf-corner--bl { bottom: 8px; left: 8px;    border-bottom: 2px solid var(--brand-accent); border-left: 2px solid var(--brand-accent); }
  .vf-corner--br { bottom: 8px; right: 8px;   border-bottom: 2px solid var(--brand-accent); border-right: 2px solid var(--brand-accent); }

  /* 상단/하단 상태 바 */
  .vf-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--text-tertiary);
    background: var(--bg-2);
  }

  [data-theme="dark"] .vf-status {
    background: #191d23;
    color: rgba(160, 180, 200, 0.6);
  }

  .vf-status--top { border-bottom: 1px solid var(--border); }
  .vf-status--bottom { border-top: 1px solid var(--border); }

  .vf-badge {
    font-weight: 700;
    font-size: 0.7rem;
    color: var(--text-primary);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 2px;
  }

  [data-theme="dark"] .vf-badge {
    color: rgba(220, 230, 255, 0.9);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .vf-rdy {
    color: #e05050;
    font-weight: 700;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    animation: rec-blink 2s step-end infinite;
  }

  @keyframes rec-blink {
    0%, 60%, 100% { opacity: 1; }
    65%, 95% { opacity: 0.2; }
  }

  .vf-shot {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  [data-theme="dark"] .vf-shot {
    color: rgba(200, 215, 230, 0.7);
  }

  .vf-af, .vf-wb, .vf-fmt {
    font-weight: 600;
    color: var(--text-secondary);
  }

  [data-theme="dark"] .vf-af,
  [data-theme="dark"] .vf-wb,
  [data-theme="dark"] .vf-fmt {
    color: rgba(160, 200, 255, 0.5);
  }

  .vf-sep { color: var(--border); opacity: 0.6; }
  .vf-spacer { flex: 1; }

  /* 중앙 콘텐츠 */
  .vf-body {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    padding: 2.5rem 1.75rem;
    position: relative;
  }

  /* 십자 포커스 마커 */
  .vf-crosshair {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    position: relative;
    opacity: 0.4;
  }

  .vf-crosshair span {
    position: absolute;
    background: var(--brand-accent);
  }

  .vf-crosshair span:first-child {
    width: 1px;
    height: 100%;
    left: 50%;
    top: 0;
  }

  .vf-crosshair span:last-child {
    height: 1px;
    width: 100%;
    top: 50%;
    left: 0;
  }

  .vf-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .vf-brand {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 660;
    letter-spacing: -0.025em;
    line-height: 0.95;
    color: var(--text-primary);
    margin: 0;
  }

  .vf-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.75;
    margin: 0;
    word-break: keep-all;
  }

  .empty {
    color: var(--text-tertiary);
    font-size: 0.9rem;
    padding: 3rem 0;
  }

  @media (max-width: 560px) {
    .vf-crosshair { display: none; }
    .vf-body { padding: 2rem 1.25rem; }
    .vf-status { padding: 0.5rem 1.25rem; gap: 0.5rem; }
    .vf-af, .vf-wb, .vf-fmt, .vf-shot { display: none; }
  }
</style>
