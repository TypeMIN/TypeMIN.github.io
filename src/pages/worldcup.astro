---
import TypeminLayout from '../layouts/TypeminLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<TypeminLayout
  title="월드컵 예측 내기"
  description="5명이 함께 쓰는 월드컵 8강 이후 예측 내기 보드"
  hideNav={true}
>
  <section
    class="bet-app"
    data-bet-app
    data-supabase-url={supabaseUrl}
    data-supabase-anon-key={supabaseAnonKey}
  >
    <button type="button" class="theme-toggle wc-theme-toggle" id="theme-toggle" aria-label="라이트/다크 전환">
      <svg class="icon--sun" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="8" cy="8" r="3" fill="currentColor"/>
        <line x1="8" y1="1" x2="8" y2="3"   stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="8" y1="13" x2="8" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="1" y1="8" x2="3" y2="8"   stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="13" y1="8" x2="15" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="3.05" y1="3.05" x2="4.46" y2="4.46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="11.54" y1="11.54" x2="12.95" y2="12.95" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="3.05" y1="12.95" x2="4.46" y2="11.54" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="11.54" y1="4.46" x2="12.95" y2="3.05" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <svg class="icon--moon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M13.5 10A6 6 0 0 1 6 2.5a.5.5 0 0 0-.64-.48A6.5 6.5 0 1 0 14.12 10.6a.5.5 0 0 0-.62-.6z" fill="currentColor"/>
      </svg>
    </button>
    <header class="hero container container--wide">
      <div>
        <h1>월드컵 예측 내기</h1>
      </div>
    </header>

    <div class="container container--wide app-stack">
      <section class="tool-block login-tool">
        <div class="block-heading">
          <h2>로그인</h2>
          <span>이름 + 4자리 PIN</span>
        </div>
        <div class="login-box" data-login-box></div>
        <p class="save-note" data-save-note>브라우저에 자동 저장됩니다.</p>
      </section>
      <div data-admin-participants></div>

      <section class="scoreboard" aria-label="점수판">
        <div class="section-head">
          <div>
            <p class="eyebrow">Leaderboard</p>
            <h2>점수판</h2>
          </div>
          <p>끝난 경기만 점수에 반영됩니다. 꼴찌는 최저점 전체가 표시됩니다.</p>
        </div>
        <div class="score-graph" data-score-graph></div>
      </section>

      <section class="prediction-board" aria-label="예측">
        <div class="section-head">
          <div>
            <p class="eyebrow">Predictions</p>
            <h2>예측</h2>
          </div>
          <p>경기 시작 전까지 본인 예측만 수정할 수 있고, 다른 사람의 선택은 경기 종료 후 공개됩니다.</p>
        </div>
        <div class="rounds" data-rounds></div>
      </section>

      <div class="private-panels" data-private-panels></div>
      <p class="api-credit">Football data provided by the Football-Data.org API.</p>
    </div>
  </section>
</TypeminLayout>

<script is:inline>
  (() => {
    const storageKey = 'typemin-worldcup-bet-v1';
    const sessionKey = 'typemin-worldcup-session-v1';
    const app = document.querySelector('[data-bet-app]');
    if (!app) return;

    const backend = {
      enabled: Boolean(app.dataset.supabaseUrl && app.dataset.supabaseAnonKey),
      client: null,
      setupTimer: null,
      refreshTimer: null,
      footballTimer: null,
      footballSyncing: false,
    };

    const stageScores = {
      r32: { regular: 1, final: 1 },
      r16: { regular: 1, final: 1 },
      qf: { regular: 2, final: 1 },
      sf: { regular: 4, final: 2 },
      third: { regular: 4, final: 2 },
      final: { regular: 6, final: 3 },
    };
    const stageOrder = ['r32', 'r16', 'qf', 'sf', 'third', 'final'];
    const stageLabels = {
      r32: '32강',
      r16: '16강',
      qf: '8강',
      sf: '4강',
      third: '3·4위전',
      final: '결승',
    };
    const SYNC_PRE_WINDOW_MS = 60 * 60 * 1000;
    const SYNC_MATCH_DURATION_MS = 150 * 60 * 1000;
    const SYNC_POST_CAP_MS = 6 * 60 * 60 * 1000;

    const defaultState = {
      participants: ['빈 자리 1', '빈 자리 2', '빈 자리 3', '빈 자리 4', '빈 자리 5'],
      participantIds: [],
      pins: ['', '', '', '', ''],
      registered: [false, false, false, false, false],
      matches: [
        { id: 'r32_1', stage: 'r32', label: '32강 1경기', teamA: '팀 1', teamB: '팀 2', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_2', stage: 'r32', label: '32강 2경기', teamA: '팀 3', teamB: '팀 4', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_3', stage: 'r32', label: '32강 3경기', teamA: '팀 5', teamB: '팀 6', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_4', stage: 'r32', label: '32강 4경기', teamA: '팀 7', teamB: '팀 8', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_5', stage: 'r32', label: '32강 5경기', teamA: '팀 9', teamB: '팀 10', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_6', stage: 'r32', label: '32강 6경기', teamA: '팀 11', teamB: '팀 12', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_7', stage: 'r32', label: '32강 7경기', teamA: '팀 13', teamB: '팀 14', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_8', stage: 'r32', label: '32강 8경기', teamA: '팀 15', teamB: '팀 16', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_9', stage: 'r32', label: '32강 9경기', teamA: '팀 17', teamB: '팀 18', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_10', stage: 'r32', label: '32강 10경기', teamA: '팀 19', teamB: '팀 20', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_11', stage: 'r32', label: '32강 11경기', teamA: '팀 21', teamB: '팀 22', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_12', stage: 'r32', label: '32강 12경기', teamA: '팀 23', teamB: '팀 24', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_13', stage: 'r32', label: '32강 13경기', teamA: '팀 25', teamB: '팀 26', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_14', stage: 'r32', label: '32강 14경기', teamA: '팀 27', teamB: '팀 28', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_15', stage: 'r32', label: '32강 15경기', teamA: '팀 29', teamB: '팀 30', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r32_16', stage: 'r32', label: '32강 16경기', teamA: '팀 31', teamB: '팀 32', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_1', stage: 'r16', label: '16강 1경기', teamA: '팀 A', teamB: '팀 B', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_2', stage: 'r16', label: '16강 2경기', teamA: '팀 C', teamB: '팀 D', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_3', stage: 'r16', label: '16강 3경기', teamA: '팀 E', teamB: '팀 F', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_4', stage: 'r16', label: '16강 4경기', teamA: '팀 G', teamB: '팀 H', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_5', stage: 'r16', label: '16강 5경기', teamA: '팀 I', teamB: '팀 J', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_6', stage: 'r16', label: '16강 6경기', teamA: '팀 K', teamB: '팀 L', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_7', stage: 'r16', label: '16강 7경기', teamA: '팀 M', teamB: '팀 N', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'r16_8', stage: 'r16', label: '16강 8경기', teamA: '팀 O', teamB: '팀 P', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'qf1', stage: 'qf', label: '8강 1경기', teamA: '프랑스', teamB: '상대팀', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'qf2', stage: 'qf', label: '8강 2경기', teamA: '팀 A', teamB: '팀 B', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'qf3', stage: 'qf', label: '8강 3경기', teamA: '팀 C', teamB: '팀 D', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'qf4', stage: 'qf', label: '8강 4경기', teamA: '팀 E', teamB: '팀 F', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'sf1', stage: 'sf', label: '4강 1경기', teamA: '팀 G', teamB: '팀 H', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'sf2', stage: 'sf', label: '4강 2경기', teamA: '팀 I', teamB: '팀 J', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'third', stage: 'third', label: '3·4위전', teamA: '팀 K', teamB: '팀 L', kickoff: '', externalId: '', crestA: '', crestB: '' },
        { id: 'final', stage: 'final', label: '결승', teamA: '팀 M', teamB: '팀 N', kickoff: '', externalId: '', crestA: '', crestB: '' },
      ],
      predictions: {},
      results: {},
      api: {
        lastSync: '',
        lastMessage: '',
      },
    };

    let state = loadState();
    let session = loadSession();
    let selectedStage = null;

    const els = {
      loginBox: app.querySelector('[data-login-box]'),
      adminParticipants: app.querySelector('[data-admin-participants]'),
      participantFields: app.querySelector('[data-participant-fields]'),
      privatePanels: app.querySelector('[data-private-panels]'),
      matchFields: null,
      resultFields: null,
      rounds: app.querySelector('[data-rounds]'),
      saveNote: app.querySelector('[data-save-note]'),
      scoreGraph: app.querySelector('[data-score-graph]'),
      apiPanel: null,
    };

    function loadState() {
      const hashState = decodeHashState();
      if (hashState) return normalizeState(hashState);

      try {
        const saved = localStorage.getItem(storageKey);
        if (saved) return normalizeState(JSON.parse(saved));
      } catch {
        localStorage.removeItem(storageKey);
      }

      return structuredClone(defaultState);
    }

    function normalizeState(nextState) {
      const clean = structuredClone(defaultState);

      if (Array.isArray(nextState.participants)) {
        clean.participants = clean.participants.map((fallback, index) =>
          String(nextState.participants[index] || fallback).trim() || fallback
        );
      }

      if (Array.isArray(nextState.pins)) {
        clean.pins = clean.pins.map((fallback, index) =>
          String(nextState.pins[index] || fallback).replace(/\D/g, '') || fallback
        );
      }

      if (Array.isArray(nextState.registered)) {
        clean.registered = clean.registered.map((fallback, index) =>
          Boolean(nextState.registered[index] ?? fallback)
        );
      }

      if (Array.isArray(nextState.matches)) {
        const savedById = new Map(nextState.matches.map((match) => [match?.id, match]));
        clean.matches = clean.matches.map((match, index) => {
          const indexed = nextState.matches[index];
          const saved = savedById.get(match.id) || (indexed?.id ? {} : indexed) || {};
          return {
            ...match,
            teamA: String(saved.teamA || match.teamA),
            teamB: String(saved.teamB || match.teamB),
            kickoff: String(saved.kickoff || ''),
            externalId: String(saved.externalId || ''),
            crestA: String(saved.crestA || match.crestA || ''),
            crestB: String(saved.crestB || match.crestB || ''),
          };
        });
      }

      clean.predictions = isRecord(nextState.predictions) ? nextState.predictions : {};
      clean.results = isRecord(nextState.results) ? nextState.results : {};
      return clean;
    }

    function loadSession() {
      try {
        const saved = JSON.parse(localStorage.getItem(sessionKey) || 'null');
        if (saved?.role === 'admin') {
          return {
            role: 'admin',
            participantIndex: null,
            participantId: null,
            pin: '',
            adminPin: String(saved.adminPin || ''),
          };
        }
        if (saved?.role === 'participant' && Number.isInteger(saved.participantIndex)) {
          return {
            role: 'participant',
            participantIndex: saved.participantIndex,
            participantId: saved.participantId || null,
            pin: String(saved.pin || ''),
            adminPin: '',
          };
        }
      } catch {
        localStorage.removeItem(sessionKey);
      }
      return { role: null, participantIndex: null, participantId: null, pin: '', adminPin: '' };
    }

    function saveSession() {
      if (!session.role) localStorage.removeItem(sessionKey);
      else localStorage.setItem(sessionKey, JSON.stringify(session));
    }

    function isAdmin() {
      return session.role === 'admin';
    }

    function isParticipant(index) {
      return session.role === 'participant' && session.participantIndex === index;
    }

    function getActiveParticipantIndexes() {
      return state.participants
        .map((_, index) => index)
        .filter(index => state.registered[index]);
    }

    function joinLocalParticipant(name, pin) {
      const cleanName = name.trim();
      if (!cleanName) {
        els.saveNote.textContent = '이름을 입력해 주세요.';
        return;
      }

      if (!/^\d{4}$/.test(pin)) {
        els.saveNote.textContent = 'PIN은 4자리 숫자로 입력해 주세요.';
        return;
      }

      const existingIndex = state.participants.findIndex((participantName, index) =>
        state.registered[index] && participantName === cleanName
      );

      if (existingIndex >= 0) {
        if (state.pins[existingIndex] !== pin) {
          els.saveNote.textContent = '이미 등록된 이름입니다. PIN을 확인해 주세요.';
          return;
        }

        session = { role: 'participant', participantIndex: existingIndex, participantId: null, pin, adminPin: '' };
        saveSession();
        saveState(`${cleanName}님으로 로그인했습니다.`);
        render();
        return;
      }

      const emptyIndex = state.registered.findIndex(registered => !registered);
      if (emptyIndex < 0) {
        els.saveNote.textContent = '참가 인원이 이미 5명입니다.';
        return;
      }

      state.participants[emptyIndex] = cleanName;
      state.pins[emptyIndex] = pin;
      state.registered[emptyIndex] = true;
      session = { role: 'participant', participantIndex: emptyIndex, participantId: null, pin, adminPin: '' };
      saveSession();
      saveState(`${cleanName}님으로 참가했습니다.`);
      render();
    }

    function isRecord(value) {
      return value && typeof value === 'object' && !Array.isArray(value);
    }

    function saveState(message = '저장되었습니다.') {
      localStorage.setItem(storageKey, JSON.stringify(state));
      els.saveNote.textContent = message;
      clearTimeout(saveState.timer);
      saveState.timer = setTimeout(() => {
        els.saveNote.textContent = backend.enabled
          ? 'Supabase에 연결되면 원격 DB에 저장됩니다.'
          : '브라우저에 자동 저장됩니다.';
      }, 1800);
    }

    async function initBackend() {
      if (!backend.enabled) {
        render();
        return;
      }

      try {
        const module = await import('https://esm.sh/@supabase/supabase-js@2');
        backend.client = module.createClient(app.dataset.supabaseUrl, app.dataset.supabaseAnonKey);
        await refreshBackendState('Supabase에 연결했습니다.');
        subscribeBackendEvents();
        syncFootballData({ silent: true }).catch((error) => {
          console.error(error);
          state.api.lastMessage = '경기 정보 자동 확인 실패';
          renderApiPanel();
        }).finally(() => {
          scheduleFootballSync();
        });
      } catch (error) {
        console.error(error);
        backend.enabled = false;
        els.saveNote.textContent = 'Supabase 연결에 실패해 로컬 모드로 실행합니다.';
        render();
      }
    }

    function backendViewerArgs() {
      if (session.role === 'participant' && session.participantId && session.pin) {
        return {
          p_participant_id: session.participantId,
          p_pin: session.pin,
        };
      }
      return {
        p_participant_id: null,
        p_pin: null,
      };
    }

    async function refreshBackendState(message) {
      if (!backend.client) return;

      const rpcName = session.role === 'admin' && session.adminPin
        ? 'worldcup_admin_state'
        : 'worldcup_public_state';
      const args = rpcName === 'worldcup_admin_state'
        ? { p_admin_pin: session.adminPin }
        : backendViewerArgs();

      const { data, error } = await backend.client.rpc(rpcName, args);
      if (error) throw error;

      state = mergeRemoteState(data);
      localStorage.setItem(storageKey, JSON.stringify(state));
      render();
      if (message) saveState(message);
    }

    function mergeRemoteState(remote) {
      const next = structuredClone(defaultState);

      if (Array.isArray(remote?.participants)) {
        remote.participants.forEach((participant) => {
          const index = Number(participant.slot) - 1;
          if (index < 0 || index >= next.participants.length) return;
          next.participants[index] = String(participant.name || next.participants[index]);
          next.registered[index] = Boolean(participant.registered);
          next.participantIds = next.participantIds || [];
          next.participantIds[index] = participant.id;
        });
      }

      if (Array.isArray(remote?.matches)) {
        next.matches = next.matches.map((fallback) => {
          const found = remote.matches.find((match) => match.id === fallback.id);
          if (!found) return fallback;
          return {
            ...fallback,
            teamA: String(found.teamA || fallback.teamA),
            teamB: String(found.teamB || fallback.teamB),
            kickoff: String(found.kickoff || ''),
            externalId: String(found.externalId || ''),
            crestA: String(found.crestA || ''),
            crestB: String(found.crestB || ''),
          };
        });

        next.results = {};
        remote.matches.forEach((match) => {
          if (match.result) next.results[match.id] = match.result;
        });
      }

      next.predictions = {};
      if (isRecord(remote?.predictions)) {
        Object.entries(remote.predictions).forEach(([slot, matchMap]) => {
          const index = Number(slot) - 1;
          if (index < 0 || !isRecord(matchMap)) return;
          next.predictions[index] = matchMap;
        });
      }

      if (isRecord(remote?.api)) {
        next.api.lastSync = String(remote.api.lastSync || '');
        next.api.lastMessage = String(remote.api.lastMessage || '');
      }

      return next;
    }

    function subscribeBackendEvents() {
      if (!backend.client) return;

      backend.client
        .channel('worldcup-events')
        .on(
          'postgres_changes',
          { event: 'INSERT', schema: 'public', table: 'worldcup_events' },
          () => {
            clearTimeout(backend.refreshTimer);
            backend.refreshTimer = setTimeout(() => {
              refreshBackendState().catch((error) => {
                console.error(error);
                els.saveNote.textContent = '원격 변경사항을 불러오지 못했습니다.';
              });
            }, 250);
          }
        )
        .subscribe();
    }

    function queueBackendSetupSave() {
      if (!backend.enabled || !backend.client) return;
      clearTimeout(backend.setupTimer);
      backend.setupTimer = setTimeout(() => {
        saveBackendSetup().catch((error) => {
          console.error(error);
          els.saveNote.textContent = '설정을 Supabase에 저장하지 못했습니다.';
        });
      }, 650);
    }

    async function saveBackendSetup() {
      const participants = state.participants.map((name, index) => ({
        slot: index + 1,
        name,
        registered: state.registered[index],
      }));
      const matches = state.matches.map((match) => ({
        id: match.id,
        teamA: match.teamA,
        teamB: match.teamB,
        kickoff: match.kickoff,
        externalId: match.externalId,
      }));

      const { data, error } = await backend.client.rpc('worldcup_admin_save_setup', {
        p_admin_pin: session.adminPin,
        p_admin_pin_next: null,
        p_participants: participants,
        p_matches: matches,
      });

      if (error) throw error;
      saveSession();
      state = mergeRemoteState(data);
      localStorage.setItem(storageKey, JSON.stringify(state));
      render();
      saveState('Supabase에 설정을 저장했습니다.');
    }

    async function saveBackendPrediction(participantIndex, matchId, pick) {
      if (!backend.enabled || !backend.client || !session.participantId || !session.pin) return;
      const { data, error } = await backend.client.rpc('worldcup_save_prediction', {
        p_participant_id: session.participantId,
        p_pin: session.pin,
        p_match_id: matchId,
        p_team: pick?.team || null,
        p_regular: pick?.regular || null,
      });
      if (error) throw error;
      state = mergeRemoteState(data);
      localStorage.setItem(storageKey, JSON.stringify(state));
      render();
      saveState('Supabase에 예측을 저장했습니다.');
    }

    async function saveBackendResult(matchId, result) {
      if (!backend.enabled || !backend.client || !isAdmin()) return;
      const { data, error } = await backend.client.rpc('worldcup_admin_set_result', {
        p_admin_pin: session.adminPin,
        p_match_id: matchId,
        p_team: result?.team || '',
        p_regular: result?.regular || '',
      });
      if (error) throw error;
      state = mergeRemoteState(data);
      localStorage.setItem(storageKey, JSON.stringify(state));
      render();
      saveState('Supabase에 결과를 저장했습니다.');
    }

    async function syncFootballData(options = {}) {
      if (!backend.enabled || !backend.client) {
        els.saveNote.textContent = '원격 DB 연결 후 사용할 수 있습니다.';
        return;
      }

      if (backend.footballSyncing) return;
      backend.footballSyncing = true;
      if (!options.silent) els.saveNote.textContent = '경기 정보를 동기화하는 중입니다.';

      try {
        const { data, error } = await backend.client.functions.invoke('sync-football-data');
        if (error) throw error;

        state.api.lastSync = new Date().toLocaleString('ko-KR');
        state.api.lastMessage = data?.message || '';
        await refreshBackendState(data?.message || '경기 정보를 동기화했습니다.');
      } finally {
        backend.footballSyncing = false;
      }
    }

    function render() {
      renderPanels();
      renderLogin();
      renderAdminParticipants();
      renderMatches();
      renderResults();
      renderApiPanel();
      renderRounds();
      renderLeaderboard();
    }

    function renderPanels() {
      if (!els.privatePanels) return;
      els.privatePanels.innerHTML = isAdmin() ? `
