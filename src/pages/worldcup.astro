    function renderRounds() {
      const stages = stageOrder.filter((s) => matchesInStage(s).length);
      const current = (selectedStage && stages.includes(selectedStage)) ? selectedStage : activeStage();
      els.rounds.innerHTML = `
        <div class="round-tabs" role="tablist">
          ${stages.map((s) => {
            const st = roundStatus(s);
            return `<button type="button" class="round-tab ${s === current ? 'is-active' : ''} is-${st.tone}" data-round-tab="${s}" role="tab" aria-selected="${s === current}">
              <span class="round-tab__name">${stageLabels[s]}</span>
              <em class="round-tab__state">${st.label}</em>
            </button>`;
          }).join('')}
        </div>
        ${renderRoundBlock(current)}
      `;
    }

    function renderRoundBlock(stage) {
      const activeIndexes = getActiveParticipantIndexes();
      const matches = matchesInStage(stage);
      if (!matches.length) return '';
      const scores = stageScores[stage];
      return `
        <section class="round-block">
          <p class="round-meta">정규 ${scores.regular} · 최종 ${scores.final}${(isRoundOpen(stage) && !isRoundLocked(stage) && roundFirstKickoff(stage)) ? ` · 마감 ${formatKickoff(roundFirstKickoff(stage))}` : ''}</p>
          <div class="round-grid">
            ${matches.map((match) => renderMatchCard(match, activeIndexes)).join('')}
          </div>
        </section>
      `;
    }

    function roundStatus(stage) {
      if (!isRoundOpen(stage)) return { label: '대기', tone: 'muted' };
      if (isRoundComplete(stage)) return { label: '종료', tone: 'done' };
      if (!isRoundLocked(stage)) return { label: '입력 가능', tone: 'open' };
      return { label: '잠김', tone: 'muted' };
    }

    function roundHint(stage) {
      if (!isRoundOpen(stage)) return '이전 라운드 종료 후 열림';
      if (!isRoundLocked(stage)) {
        const first = roundFirstKickoff(stage);
        return first ? `마감 ${formatKickoff(first)}` : '';
      }
      return '';
    }

    function renderMatchCard(match, activeIndexes) {
      const finished = isMatchFinished(match);
      const currentIndex = activeIndexes.find((participantIndex) => isParticipant(participantIndex));
      const otherIndexes = activeIndexes.filter((participantIndex) => !isParticipant(participantIndex));
      const pending = activeIndexes.filter((i) => !hasPicked(i, match)).map((i) => state.participants[i]);
      const submitted = activeIndexes.length - pending.length;
      const determined = teamsDetermined(match.stage);
      const statusLabel = finished ? '종료' : !isRoundOpen(match.stage) ? '대기' : isRoundLocked(match.stage) ? '잠김' : '입력 가능';
      const statusTone = finished ? 'done' : statusLabel === '입력 가능' ? 'open' : 'locked';

      return `
        <article class="match-card ${finished ? 'is-finished' : ''}">
          <div class="match-card__top">
            <div>
              <strong>${escapeHtml(match.label)}</strong>
              <small>${formatKickoff(match.kickoff)}</small>
            </div>
            <span class="match-status is-${statusTone}">${statusLabel}</span>
          </div>
          <div class="vs-block">
            ${renderTeamSide(match, 'A')}
            ${vsCenterHtml(match)}
            ${renderTeamSide(match, 'B')}
          </div>
          <div class="prediction-area">
            <div class="prediction-self">
              <span class="area-label">내 예측</span>
              ${Number.isInteger(currentIndex) ? renderSelfPrediction(currentIndex, match, determined) : '<span class="pick-status">로그인 후 입력</span>'}
            </div>
            ${!finished && activeIndexes.length ? `
              <div class="pick-progress">
                <span class="area-label">제출</span>
                <span class="pick-dots">
                  ${activeIndexes.map((participantIndex) => `<i class="pick-dot ${hasPicked(participantIndex, match) ? 'is-on' : ''}" title="${escapeAttr(state.participants[participantIndex])}"></i>`).join('')}
                </span>
                <span class="pick-count">${submitted}/${activeIndexes.length}</span>
              </div>
            ` : ''}
            ${!finished && activeIndexes.length
              ? pending.length > 0
                ? `<p class="pick-pending">미제출 · ${pending.map(escapeHtml).join(', ')}</p>`
                : '<p class="pick-pending is-done">전원 제출</p>'
              : ''}
            ${finished && otherIndexes.length ? `
              <div class="other-picks">
                <span class="area-label">다른 사람</span>
                <ul>
                  ${otherIndexes.map((participantIndex) => `
                    <li>
                      <span>${escapeHtml(state.participants[participantIndex])}</span>
                      ${renderPredictionCell(participantIndex, match)}
                    </li>
                  `).join('')}
                </ul>
              </div>
            ` : ''}
          </div>
          ${!determined ? '<p class="round-note">진출팀 확정 후 선택 가능</p>' : ''}
        </article>
      `;
    }

    function vsCenterHtml(match) {
      const r = state.results[match.id];
      const finished = isMatchFinished(match);
      if (!finished || r == null || r.home == null || r.away == null) {
        return '<span class="vs-mark">VS</span>';
      }
      const label = r.duration === 'EXTRA_TIME' ? 'AET' : r.duration === 'PENALTY_SHOOTOUT' ? 'PSO' : 'FT';
      const tone = r.duration && r.duration !== 'REGULAR' ? 'is-et' : '';
      const pens = (r.penHome != null && r.penAway != null)
        ? `<span class="vs-pens">(${Number(r.penHome)} : ${Number(r.penAway)})</span>` : '';
      return `
        <span class="vs-center">
          <em class="vs-status ${tone}">${label}</em>
          <span class="vs-score">${Number(r.home)} : ${Number(r.away)}</span>
          ${pens}
        </span>`;
    }

    function hasPicked(participantIndex, match) {
      return Boolean(getPrediction(participantIndex, match.id));
    }

    function renderSelfPrediction(participantIndex, match, determined) {
      if (!determined) {
        return `<select data-pick="prediction:${participantIndex}:${match.id}" aria-label="${match.label}" disabled><option>진출팀 확정 후 선택</option></select>`;
      }
      return renderPredictionCell(participantIndex, match);
    }

    function renderTeamSide(match, side) {
      const name = teamName(match, side);
      const flag = teamsDetermined(match.stage) ? flagUrl(name) : '';
      const crest = teamsDetermined(match.stage) ? teamCrest(match, side) : '';
      const r = state.results[match.id];
      const isWinner = isMatchFinished(match) && r && r.team === side;
      const badge = flag
        ? `<span class="team-badge"><img src="${escapeAttr(flag)}" alt="${escapeAttr(name)}" loading="lazy" /></span>`
        : crest
          ? `<span class="team-badge"><img src="${escapeAttr(crest)}" alt="${escapeAttr(name)}" loading="lazy" /></span>`
        : `<span class="team-badge">${escapeHtml(teamInitials(name))}</span>`;
      return `
        <div class="team-side ${isWinner ? 'is-winner' : ''}">
          ${badge}
          <strong>${escapeHtml(name)}</strong>
        </div>
      `;
    }

    function teamInitials(name) {
      return String(name || '미정').replace(/\s+/g, '').slice(0, 2) || '미정';
    }

    function renderPredictionCell(participantIndex, match) {
      const pick = getPrediction(participantIndex, match.id);
      const finished = isMatchFinished(match);
      const locked = isRoundLocked(match.stage);
      const canEdit = isParticipant(participantIndex) && isRoundOpen(match.stage) && !locked;

      if (canEdit) {
        return buildSelect(`prediction:${participantIndex}:${match.id}`, pick, match, false, false);
      }

      if (isParticipant(participantIndex) || finished) {
        return `<span class="pick-text">${escapeHtml(formatPick(pick, match) || '미제출')}</span>`;
      }

      return `<span class="pick-status ${pick ? 'is-submitted' : ''}">${pick ? '제출함' : '미제출'}</span>`;
    }

    function renderLeaderboard() {
      const activeIndexes = getActiveParticipantIndexes();
      if (activeIndexes.length === 0) {
        renderScoreGraph([]);
        return;
      }

      const rows = activeIndexes.map((index) => ({
        name: state.participants[index],
        index,
        ...calculateParticipant(index),
      }));

      const minScore = Math.min(...rows.map(row => row.total));
      const sorted = rows.sort((a, b) => b.total - a.total || a.index - b.index);
      renderScoreGraph(sorted);
    }

    function renderScoreGraph(rows) {
      if (!els.scoreGraph) return;
      if (!rows.length) {
        els.scoreGraph.innerHTML = '<p class="empty-state">아직 참가자가 없습니다. 이름과 4자리 PIN으로 참가해 주세요.</p>';
        return;
      }

      const minScore = Math.min(...rows.map(row => row.total));
      const maxScore = Math.max(1, ...rows.map(row => row.total));
      const hasAnyResult = state.matches.some((m) => Boolean(state.results[m.id]));
      els.scoreGraph.innerHTML = rows.map((row, rankIndex) => {
        const isLast = hasAnyResult && rows.length > 1 && row.total === minScore;
        const width = Math.max(4, Math.round((row.total / maxScore) * 100));
        return `
          <div class="rank-row ${isLast ? 'is-last' : ''}">
            <span class="rank">${rankIndex + 1}</span>
            <span class="rank-name">${escapeHtml(row.name)}</span>
            <div class="graph-track">
              <i style="width: ${width}%"></i>
            </div>
            <strong>${row.total}</strong>
          </div>
        `;
      }).join('');
    }

    function calculateParticipant(participantIndex) {
      const byStage = { qf: 0, sf: 0, third: 0, final: 0 };
      let total = 0;

      state.matches.forEach((match) => {
        const pick = getPrediction(participantIndex, match.id);
        const result = state.results[match.id];
        if (!pick || !result) return;

        const scores = stageScores[match.stage];
        const regularHit = isRegularHit(pick, result);
        const finalHit = pick.team === result.team;
        const earned = (regularHit ? scores.regular : 0) + (finalHit ? scores.final : 0);

        byStage[match.stage] += earned;
        total += earned;
      });

      return { total, byStage };
    }

    function isRegularHit(pick, result) {
      if (result.regular === 'draw') return pick.regular === 'draw';
      return pick.regular === 'win' && pick.team === result.team;
    }

    function getPrediction(participantIndex, matchId) {
      return state.predictions[participantIndex]?.[matchId] || null;
    }

    function isMatchFinished(match) {
      return Boolean(state.results[match.id]);
    }

    const feederStage = { r16: 'r32', qf: 'r16', sf: 'qf', third: 'sf', final: 'sf' };

    function matchesInStage(stage) {
      return state.matches.filter((m) => m.stage === stage);
    }

    function activeStage() {
      return stageOrder.find((s) => matchesInStage(s).length && !isRoundComplete(s)) || 'final';
    }

    function isRoundComplete(stage) {
      const ms = matchesInStage(stage);
      return ms.length > 0 && ms.every((m) => Boolean(state.results[m.id]));
    }

    function isRoundOpen(stage) {
      const feeder = feederStage[stage];
      if (!feeder) return true;
      return isRoundComplete(feeder);
    }

    function roundFirstKickoff(stage) {
      const times = matchesInStage(stage)
        .map((m) => m.kickoff)
        .filter(Boolean)
        .map((v) => new Date(v).getTime())
        .filter((t) => !Number.isNaN(t));
      return times.length ? Math.min(...times) : null;
    }

    function isRoundLocked(stage) {
      if (matchesInStage(stage).some((m) => Boolean(state.results[m.id]))) return true;
      const first = roundFirstKickoff(stage);
      if (first == null) return false;
      return Date.now() >= first;
    }

    function teamsDetermined(stage) {
      return isRoundOpen(stage);
    }

    const FLAG_CODES = {"andorra":"ad","united arab emirates":"ae","afghanistan":"af","antigua & barbuda":"ag","anguilla":"ai","albania":"al","armenia":"am","angola":"ao","antarctica":"aq","argentina":"ar","american samoa":"as","austria":"at","australia":"au","aruba":"aw","åland islands":"ax","azerbaijan":"az","bosnia & herzegovina":"ba","barbados":"bb","bangladesh":"bd","belgium":"be","burkina faso":"bf","bulgaria":"bg","bahrain":"bh","burundi":"bi","benin":"bj","st. barthélemy":"bl","bermuda":"bm","brunei":"bn","bolivia":"bo","brazil":"br","bahamas":"bs","bhutan":"bt","bouvet island":"bv","botswana":"bw","belarus":"by","belize":"bz","canada":"ca","cocos (keeling) islands":"cc","congo - kinshasa":"cd","central african republic":"cf","congo - brazzaville":"cg","switzerland":"ch","côte d’ivoire":"ci","cook islands":"ck","chile":"cl","cameroon":"cm","china":"cn","colombia":"co","sark":"cq","costa rica":"cr","cuba":"cu","cape verde":"cv","curaçao":"cw","christmas island":"cx","cyprus":"cy","czechia":"cz","germany":"de","djibouti":"dj","denmark":"dk","dominica":"dm","dominican republic":"do","algeria":"dz","ecuador":"ec","estonia":"ee","egypt":"eg","western sahara":"eh","eritrea":"er","spain":"es","ethiopia":"et","finland":"fi","fiji":"fj","falkland islands":"fk","micronesia":"fm","faroe islands":"fo","france":"fr","gabon":"ga","united kingdom":"gb","grenada":"gd","georgia":"ge","french guiana":"gf","guernsey":"gg","ghana":"gh","gibraltar":"gi","greenland":"gl","gambia":"gm","guinea":"gn","guadeloupe":"gp","equatorial guinea":"gq","greece":"gr","south georgia & south sandwich islands":"gs","guatemala":"gt","guam":"gu","guinea-bissau":"gw","guyana":"gy","hong kong sar china":"hk","heard & mcdonald islands":"hm","honduras":"hn","croatia":"hr","haiti":"ht","hungary":"hu","indonesia":"id","ireland":"ie","israel":"il","isle of man":"im","india":"in","british indian ocean territory":"io","iraq":"iq","iran":"ir","iceland":"is","italy":"it","jersey":"je","jamaica":"jm","jordan":"jo","japan":"jp","kenya":"ke","kyrgyzstan":"kg","cambodia":"kh","kiribati":"ki","comoros":"km","st. kitts & nevis":"kn","north korea":"kp","south korea":"kr","kuwait":"kw","cayman islands":"ky","kazakhstan":"kz","laos":"la","lebanon":"lb","st. lucia":"lc","liechtenstein":"li","sri lanka":"lk","liberia":"lr","lesotho":"ls","lithuania":"lt","luxembourg":"lu","latvia":"lv","libya":"ly","morocco":"ma","monaco":"mc","moldova":"md","montenegro":"me","st. martin":"mf","madagascar":"mg","marshall islands":"mh","north macedonia":"mk","mali":"ml","myanmar (burma)":"mm","mongolia":"mn","macao sar china":"mo","northern mariana islands":"mp","martinique":"mq","mauritania":"mr","montserrat":"ms","malta":"mt","mauritius":"mu","maldives":"mv","malawi":"mw","mexico":"mx","malaysia":"my","mozambique":"mz","namibia":"na","new caledonia":"nc","niger":"ne","norfolk island":"nf","nigeria":"ng","nicaragua":"ni","netherlands":"nl","norway":"no","nepal":"np","nauru":"nr","niue":"nu","new zealand":"nz","oman":"om","panama":"pa","peru":"pe","french polynesia":"pf","papua new guinea":"pg","philippines":"ph","pakistan":"pk","poland":"pl","st. pierre & miquelon":"pm","pitcairn islands":"pn","puerto rico":"pr","palestinian territories":"ps","portugal":"pt","palau":"pw","paraguay":"py","qatar":"qa","réunion":"re","romania":"ro","serbia":"rs","russia":"ru","rwanda":"rw","saudi arabia":"sa","solomon islands":"sb","seychelles":"sc","sudan":"sd","sweden":"se","singapore":"sg","st. helena":"sh","slovenia":"si","svalbard & jan mayen":"sj","slovakia":"sk","sierra leone":"sl","san marino":"sm","senegal":"sn","somalia":"so","suriname":"sr","south sudan":"ss","são tomé & príncipe":"st","el salvador":"sv","sint maarten":"sx","syria":"sy","eswatini":"sz","turks & caicos islands":"tc","chad":"td","french southern territories":"tf","togo":"tg","thailand":"th","tajikistan":"tj","tokelau":"tk","timor-leste":"tl","turkmenistan":"tm","tunisia":"tn","tonga":"to","türkiye":"tr","trinidad & tobago":"tt","tuvalu":"tv","taiwan":"tw","tanzania":"tz","ukraine":"ua","uganda":"ug","u.s. outlying islands":"um","united states":"us","uruguay":"uy","uzbekistan":"uz","vatican city":"va","st. vincent & grenadines":"vc","venezuela":"ve","british virgin islands":"vg","u.s. virgin islands":"vi","vietnam":"vn","vanuatu":"vu","wallis & futuna":"wf","samoa":"ws","kosovo":"xk","yemen":"yd","mayotte":"yt","south africa":"za","zambia":"zm","zimbabwe":"zw","england":"gb-eng","scotland":"gb-sct","wales":"gb-wls","northern ireland":"gb-nir","korea republic":"kr","korea, south":"kr","korea dpr":"kp","usa":"us","united states of america":"us","ivory coast":"ci","cote d ivoire":"ci","ir iran":"ir","czech republic":"cz","turkey":"tr","turkiye":"tr","cabo verde":"cv","dr congo":"cd","democratic republic of the congo":"cd","congo dr":"cd","bosnia and herzegovina":"ba","bosnia":"ba","curacao":"cw","viet nam":"vn","the gambia":"gm","uae":"ae","hong kong":"hk","chinese taipei":"tw","china pr":"cn","macedonia":"mk","swaziland":"sz","east timor":"tl","myanmar":"mm"};

    function flagUrl(name) {
      const code = FLAG_CODES[String(name || '').trim().toLowerCase()];
      return code ? `https://flagcdn.com/${code}.svg` : '';
    }

    function teamName(match, side) {
      if (!teamsDetermined(match.stage)) return '미정';
      return side === 'A' ? match.teamA : match.teamB;
    }

    function teamCrest(match, side) {
      return side === 'A' ? match.crestA || '' : match.crestB || '';
    }

    function formatKickoff(value) {
      if (!value) return '시작 시각 미정';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '시작 시각 확인 필요';
      return date.toLocaleString('ko-KR', {
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
      });
    }

    function setPrediction(participantIndex, matchId, value) {
      if (!state.predictions[participantIndex]) state.predictions[participantIndex] = {};
      if (!value) {
        delete state.predictions[participantIndex][matchId];
        return;
      }
      state.predictions[participantIndex][matchId] = parseValue(value);
    }

    function buildSelect(name, selected, match, includeEmpty, disabled) {
      const options = [
        includeEmpty ? '<option value="">미입력</option>' : '<option value="">선택</option>',
        optionHtml(match, selected, 'A', 'win'),
        optionHtml(match, selected, 'A', 'draw'),
        optionHtml(match, selected, 'B', 'draw'),
        optionHtml(match, selected, 'B', 'win'),
      ].join('');

      return `<select data-pick="${name}" aria-label="${match.label}" ${disabled ? 'disabled' : ''}>${options}</select>`;
    }

    function optionHtml(match, selected, team, regular) {
      const value = `${team}:${regular}`;
      const isSelected = selected?.team === team && selected?.regular === regular;
      return `<option value="${value}" ${isSelected ? 'selected' : ''}>${escapeHtml(formatPick({ team, regular }, match))}</option>`;
    }

    function parseValue(value) {
      const [team, regular] = value.split(':');
      if (!['A', 'B'].includes(team) || !['win', 'draw'].includes(regular)) return null;
      return { team, regular };
    }

    function formatPick(pick, match) {
      if (!pick || !pick.team) return '';
      const teamName = pick.team === 'A' ? match.teamA : match.teamB;
      const label = pick.regular === 'win' ? '승' : '무';
      return `${teamName}(${label})`;
    }

    function decodeHashState() {
      const hash = window.location.hash;
      if (!hash.startsWith('#state=')) return null;
      try {
        const bytes = atob(hash.slice(7));
        const json = decodeURIComponent(bytes.split('').map(char =>
          `%${char.charCodeAt(0).toString(16).padStart(2, '0')}`
        ).join(''));
        return JSON.parse(json);
      } catch {
        return null;
      }
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function escapeAttr(value) {
      return escapeHtml(value);
    }

    app.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;

      if (target.dataset.participant) {
        if (!isAdmin()) return;
        const index = Number(target.dataset.participant);
        state.participants[index] = target.value || `참가자 ${index + 1}`;
        saveState();
        renderLogin();
        renderRounds();
        renderLeaderboard();
        queueBackendSetupSave();
      }

      if (target.dataset.matchTeam) {
        if (!isAdmin()) return;
        const [index, key] = target.dataset.matchTeam.split(':');
        state.matches[Number(index)][key] = target.value || (key === 'teamA' ? '팀 A' : '팀 B');
        saveState();
        renderResults();
        renderRounds();
        renderLeaderboard();
        queueBackendSetupSave();
      }

      if (target.dataset.kickoff) {
        if (!isAdmin()) return;
        const index = Number(target.dataset.kickoff);
        state.matches[index].kickoff = target.value;
        saveState();
        renderRounds();
        queueBackendSetupSave();
      }

      if (target.dataset.externalId) {
        if (!isAdmin()) return;
        const index = Number(target.dataset.externalId);
        state.matches[index].externalId = target.value.trim();
        saveState();
        queueBackendSetupSave();
      }
    });

    app.addEventListener('change', (event) => {
      const target = event.target;

      if (target instanceof HTMLSelectElement && target.dataset.pick) {
        const [kind, participantIndex, matchId] = target.dataset.pick.split(':');
        if (kind === 'prediction') {
          const index = Number(participantIndex);
          const match = state.matches.find(item => item.id === matchId);
          if (!match || !isParticipant(index) || !isRoundOpen(match.stage) || isRoundLocked(match.stage)) return;
          setPrediction(index, matchId, target.value);
          if (backend.enabled) {
            saveBackendPrediction(index, matchId, parseValue(target.value)).catch((error) => {
              console.error(error);
              els.saveNote.textContent = '예측을 Supabase에 저장하지 못했습니다.';
              refreshBackendState().catch(() => {});
            });
          }
        }
        if (kind === 'result') {
          if (!isAdmin()) return;
          const resultMatchId = participantIndex;
          const parsed = parseValue(target.value);
          if (parsed) state.results[resultMatchId] = parsed;
          else delete state.results[resultMatchId];
          if (backend.enabled) {
            saveBackendResult(resultMatchId, parsed).catch((error) => {
              console.error(error);
              els.saveNote.textContent = '결과를 Supabase에 저장하지 못했습니다.';
              refreshBackendState().catch(() => {});
            });
          }
        }
        saveState();
        renderRounds();
        renderLeaderboard();
      }

    });

    app.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const tab = target.closest('[data-round-tab]');
      if (tab) { selectedStage = tab.dataset.roundTab; renderRounds(); return; }

      if (target.dataset.login !== undefined) {
        const nameInput = app.querySelector('[data-login-name]');
        const pinInput = app.querySelector('[data-login-pin]');
        if (!(nameInput instanceof HTMLInputElement) || !(pinInput instanceof HTMLInputElement)) return;

        const name = nameInput.value.trim();
        const pin = pinInput.value.trim();

        if (backend.enabled && backend.client) {
          backend.client.rpc('worldcup_join', {
            p_name: name,
            p_pin: pin,
          }).then(async ({ data, error }) => {
            if (error) throw error;
            if (data?.role === 'admin') {
              session = { role: 'admin', participantIndex: null, participantId: null, pin: '', adminPin: pin };
              saveSession();
              await refreshBackendState('로그인했습니다.');
              return;
            }
            if (data?.role === 'participant') {
              session = {
                role: 'participant',
                participantIndex: Number(data.slot) - 1,
                participantId: data.participantId,
                pin,
                adminPin: '',
              };
              saveSession();
              await refreshBackendState(`${data.name}님으로 로그인했습니다.`);
              return;
            }
            els.saveNote.textContent = data?.reason === 'full'
              ? '참가 인원이 이미 5명입니다.'
              : '이미 등록된 이름입니다. PIN을 확인해 주세요.';
          }).catch((error) => {
            console.error(error);
            els.saveNote.textContent = 'Supabase 참가/로그인에 실패했습니다.';
          });
          return;
        }

        joinLocalParticipant(name, pin);
      }

      if (target.dataset.logout !== undefined) {
        session = { role: null, participantIndex: null, participantId: null, pin: '', adminPin: '' };
        saveSession();
        saveState('로그아웃했습니다.');
        if (backend.enabled) refreshBackendState().catch(() => render());
        else render();
      }

      if (target.dataset.clearParticipant) {
        if (!isAdmin()) return;
        const index = Number(target.dataset.clearParticipant);
        state.registered[index] = false;
        state.participants[index] = `빈 자리 ${index + 1}`;
        state.pins[index] = '';
        delete state.predictions[index];
        saveState();
        render();
        queueBackendSetupSave();
      }

      if (target.dataset.syncFootball !== undefined) {
        syncFootballData().catch((error) => {
          console.error(error);
          els.saveNote.textContent = '경기 정보 동기화에 실패했습니다.';
        });
      }
    });

    initBackend();
  })();
</script>

