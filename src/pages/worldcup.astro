          <div class="login-form">
            <input type="text" data-login-name placeholder="이름(3글자)" autocomplete="name" />
            <input type="password" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" data-login-pin placeholder="PIN 4자리" />
            <button type="button" class="btn-main btn-sm" data-login>참가 / 로그인</button>
