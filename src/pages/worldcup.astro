    function renderApiPanel() {
      if (!els.apiPanel) return;
      els.apiPanel.innerHTML = `
        <button type="button" class="btn-main" data-sync-football ${backend.enabled ? '' : 'disabled'}>경기 정보 동기화</button>
        <p class="login-hint">football-data.org API 키를 Supabase 함수 secret에 넣으면 팀명, 시작 시각, 종료 결과를 가져옵니다. 운영 모드에서는 경기 시작/종료 즈음 자동으로 다시 확인합니다.</p>
