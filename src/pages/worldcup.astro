    function scheduleFootballSync() {
      clearInterval(backend.footballTimer);
      backend.footballTimer = null;
      if (!backend.enabled || !backend.client) return;
      backend.footballTimer = setInterval(() => {
        if (!shouldSyncNow()) return;
        syncFootballData({ silent: true }).catch((error) => {
          console.error(error);
          state.api.lastMessage = '자동 동기화 실패';
          renderApiPanel();
        });
      }, 5 * 60 * 1000);
    }

    function shouldSyncNow() {
      const now = Date.now();
      return state.matches.some((match) => {
        if (!match.kickoff) return false;
        const t = new Date(match.kickoff).getTime();
        if (Number.isNaN(t)) return false;
        const preHit = now >= t - SYNC_PRE_WINDOW_MS && now <= t;
        const end = t + SYNC_MATCH_DURATION_MS;
        const postHit = now >= end && now <= end + SYNC_POST_CAP_MS && !isMatchFinished(match);
        return preHit || postHit;
      });
    }

