---
import { getCollection, render } from 'astro:content';
import CarlinisLayout from '../../layouts/CarlinisLayout.astro';
import TagList from '../../components/TagList.astro';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<CarlinisLayout title={`${entry.data.title} — carlinis`} description={entry.data.description}>
  <article class="container container--reading article-page">
    <a class="back-link" href="/carlinis">carlinis</a>
    <header class="article-header">
      <p class="article-meta">{entry.data.date.toLocaleDateString('ko-KR')} · {entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      <TagList tags={entry.data.tags} />
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</CarlinisLayout>

<style>
  .article-page {
    padding-bottom: 5rem;
    padding-top: 4rem;
  }

  .back-link,
  .article-meta {
    color: var(--text-tertiary);
    font-size: 0.78rem;
  }

  .article-header {
    border-bottom: 0.5px solid var(--border);
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
  }

  .article-header h1 {
    color: var(--text-primary);
    font-size: clamp(2.2rem, 7vw, 4.2rem);
    line-height: 1;
    margin: 0.8rem 0;
  }

  .article-header p {
    color: var(--text-secondary);
    line-height: 1.7;
  }
</style>
