---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = 'TypeMIN — 만들고, 기록하고, 탐색합니다.', ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage ?? new URL('/og-default.svg', Astro.site).toString();
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ko" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var theme = saved === 'light' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <style is:global>
      /* ── 폰트 ── */
      :root {
        --font-sans: 'Pretendard Variable', 'Pretendard', -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', 'Fira Code', monospace;
      }

      /* ── 컬러 변수 — 다크 기본 ── */
      [data-theme="dark"] {
        --cobalt:       #1E3A8A;
        --cobalt-light: #4A6ABE;
        --cobalt-dim:   #0C1030;
        --gold:         #D4A020;
        --gold-light:   #EAB840;
        --gold-dim:     #1C1400;
        --crimson:      #C03030;
        --crimson-light:#E05050;
        --crimson-dim:  #1A0808;
        --teal:         #30A888;
        --teal-light:   #50C8A8;
        --teal-dim:     #081410;

        --bg-0: #08090F;
        --bg-1: #0E1020;
        --bg-2: #161830;
        --bg-3: #1E2040;

        --text-primary:   #E8EAFF;
        --text-secondary: #A0A8CC;
        --text-tertiary:  #606888;
        --border:         rgba(255,255,255,0.08);
        --border-soft:    rgba(255,255,255,0.04);
      }

      [data-theme="light"] {
        --cobalt:       #1E3A8A;
        --cobalt-light: #4A6ABE;
        --cobalt-dim:   #EEF2FF;
        --gold:         #D4A020;
        --gold-light:   #B8820A;
        --gold-dim:     #FFFBEB;
        --crimson:      #C03030;
        --crimson-light:#A01010;
        --crimson-dim:  #FFF1F1;
        --teal:         #30A888;
        --teal-light:   #187860;
        --teal-dim:     #F0FDF9;

        --bg-0: #FFFFFF;
        --bg-1: #F7F8FC;
        --bg-2: #EEEEF6;
        --bg-3: #E0E2F0;

        --text-primary:   #0A0C1A;
        --text-secondary: #404468;
        --text-tertiary:  #8090B0;
        --border:         rgba(0,0,0,0.1);
        --border-soft:    rgba(0,0,0,0.05);
      }

      /* ── 리셋 & 기본 ── */
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html { scroll-behavior: smooth; }

      body {
        font-family: var(--font-sans);
        background: var(--bg-0);
        color: var(--text-primary);
        line-height: 1.7;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: background 0.2s, color 0.2s;
      }

      main { flex: 1; }

      a { color: var(--cobalt-light); text-decoration: none; }
      a:hover { text-decoration: underline; }

      code {
        font-family: var(--font-mono);
        font-size: 0.875em;
        background: var(--bg-2);
        border: 0.5px solid var(--border);
        border-radius: 4px;
        padding: 2px 6px;
      }

      pre {
        font-family: var(--font-mono);
        background: var(--bg-1) !important;
        border: 0.5px solid var(--border);
        border-radius: 10px;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.25rem 0;
      }

      pre code { background: none; border: none; padding: 0; font-size: 0.875rem; }

      img { max-width: 100%; height: auto; }

      /* ── 공통 컴포넌트 ── */
      .container { width: 100%; max-width: 800px; margin: 0 auto; padding: 0 1.25rem; }
      .container--wide { max-width: 1100px; }

      .btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.55rem 1.25rem; border-radius: 7px; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: none; text-decoration: none; transition: opacity 0.15s, background 0.15s; white-space: nowrap; }
      .btn:hover { text-decoration: none; opacity: 0.85; }
      .btn--primary { background: var(--cobalt); color: #EEF0FA; }
      .btn--ghost { background: transparent; color: var(--text-secondary); border: 0.5px solid var(--border); }
      .btn--ghost:hover { background: var(--bg-1); opacity: 1; }

      .badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 2px 9px; border-radius: 99px; letter-spacing: 0.05em; }
      .badge--dev     { background: var(--cobalt-dim); color: var(--cobalt-light); }
      .badge--photo   { background: var(--gold-dim);   color: var(--gold-light);   }
      .badge--music   { background: var(--crimson-dim);color: var(--crimson-light);}
      .badge--writing { background: var(--teal-dim);   color: var(--teal-light);   }
      .badge--essay   { background: var(--bg-2);       color: var(--text-secondary);}

      .section-label { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 1rem; }

      /* ── 네비게이션 ── */
      .nav {
        border-bottom: 0.5px solid var(--border);
        background: var(--bg-0);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
      }

      .nav__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 52px;
      }

      .nav__logo {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-primary);
        letter-spacing: -0.01em;
      }
      .nav__logo span { color: var(--cobalt-light); }

      .nav__links { display: flex; align-items: center; gap: 1.5rem; }

      .nav__link { font-size: 0.875rem; color: var(--text-secondary); transition: color 0.15s; }
      .nav__link:hover, .nav__link.active { color: var(--text-primary); text-decoration: none; }

      .nav__toggle {
        background: none;
        border: 0.5px solid var(--border);
        border-radius: 6px;
        padding: 5px 8px;
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 0.8rem;
        font-family: var(--font-sans);
        transition: background 0.15s;
      }
      .nav__toggle:hover { background: var(--bg-2); }

      /* ── 푸터 ── */
      .footer {
        border-top: 0.5px solid var(--border);
        padding: 2rem 0;
        margin-top: 4rem;
      }

      .footer__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--text-tertiary);
      }

      .footer__links { display: flex; gap: 1.25rem; }
      .footer__links a { color: var(--text-tertiary); }
      .footer__links a:hover { color: var(--text-secondary); text-decoration: none; }

      /* ── prose (블로그 글 본문) ── */
      .prose h1, .prose h2, .prose h3, .prose h4 { color: var(--text-primary); font-weight: 600; line-height: 1.3; margin: 2rem 0 0.75rem; }
      .prose h1 { font-size: 1.75rem; }
      .prose h2 { font-size: 1.35rem; border-bottom: 0.5px solid var(--border); padding-bottom: 0.5rem; }
      .prose h3 { font-size: 1.1rem; }
      .prose p { margin: 0.9rem 0; color: var(--text-secondary); }
      .prose ul, .prose ol { padding-left: 1.5rem; margin: 0.9rem 0; color: var(--text-secondary); }
      .prose li { margin: 0.3rem 0; }
      .prose blockquote { border-left: 3px solid var(--cobalt-light); padding: 0.5rem 1rem; margin: 1rem 0; color: var(--text-secondary); background: var(--bg-1); border-radius: 0 6px 6px 0; }
      .prose hr { border: none; border-top: 0.5px solid var(--border); margin: 2rem 0; }
      .prose a { color: var(--cobalt-light); }
      .prose strong { color: var(--text-primary); font-weight: 600; }

      /* ── 애니메이션 ── */
      @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
      .fade-in { animation: fadeIn 0.5s ease both; }

      @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

      /* ── 반응형 ── */
      @media (max-width: 640px) {
        .nav__links .nav__link:not(.nav__link--mobile) { display: none; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <div class="container nav__inner">
        <a href="/" class="nav__logo">Type<span>MIN</span></a>
        <div class="nav__links">
          <a href="/posts" class={`nav__link${currentPath.startsWith('/posts') ? ' active' : ''}`}>글</a>
          <a href="/works" class={`nav__link${currentPath.startsWith('/works') ? ' active' : ''}`}>Works</a>
          <a href="/about" class={`nav__link${currentPath === '/about/' || currentPath === '/about' ? ' active' : ''}`}>About</a>
          <button class="nav__toggle" id="theme-toggle" aria-label="테마 전환">🌙</button>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <span>© 2025 TypeMIN</span>
        <div class="footer__links">
          <a href="https://github.com/TypeMIN" target="_blank" rel="noopener">GitHub</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      var btn = document.getElementById('theme-toggle');
      function syncBtn() {
        var t = document.documentElement.getAttribute('data-theme');
        if (btn) btn.textContent = t === 'dark' ? '☀️' : '🌙';
      }
      syncBtn();
      if (btn) {
        btn.addEventListener('click', function() {
          var cur = document.documentElement.getAttribute('data-theme');
          var next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          syncBtn();
        });
      }
    </script>
  </body>
</html>
