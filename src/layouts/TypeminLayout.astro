---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  hideNav?: boolean;
}

const { title, description, ogImage, hideNav = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} brandClass="theme-typemin" navMode="main" hideNav={hideNav}>
  <slot />
</BaseLayout>

<style is:global>
  .theme-typemin {
    --brand-accent: var(--cobalt-light);
  }
</style>
