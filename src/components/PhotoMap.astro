---
interface Marker {
  lat: number;
  lng: number;
  title: string;
  href: string;
  location?: string;
}

interface Props {
  markers: Marker[];
}

const { markers } = Astro.props;
---

<div class="map-section">
  <div class="map-label">
    <span class="map-label__icon" aria-hidden="true">◎</span>
    <span>다녔던 곳</span>
    <span class="map-label__count">{markers.length} locations</span>
  </div>
  <div id="photo-map" class="photo-map"></div>
</div>

<script define:vars={{ markers }}>
  function loadLeaflet() {
    return new Promise((resolve) => {
      if (window.L) { resolve(); return; }

      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(link);

      const script = document.createElement('script');
      script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.onload = resolve;
      document.head.appendChild(script);
    });
  }

  function makeIcon(accent) {
    return window.L.divIcon({
      className: '',
      html: `<svg width="22" height="30" viewBox="0 0 22 30" xmlns="http://www.w3.org/2000/svg">
        <path d="M11 0C4.93 0 0 4.93 0 11c0 8.28 11 19 11 19S22 19.28 22 11C22 4.93 17.07 0 11 0z" fill="${accent}"/>
        <circle cx="11" cy="11" r="4.5" fill="rgba(255,255,255,0.88)"/>
      </svg>`,
      iconSize: [22, 30],
      iconAnchor: [11, 30],
      popupAnchor: [0, -32],
    });
  }

  async function initMap() {
    await loadLeaflet();
    const L = window.L;

    const el = document.getElementById('photo-map');
    if (!el || el._leaflet_id) return;

    const isDark = document.documentElement.dataset.theme === 'dark';

    const lightTile = 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';
    const darkTile  = 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png';
    const attribution = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>';

    const map = L.map('photo-map', {
      scrollWheelZoom: false,
      zoomControl: true,
      attributionControl: true,
    });

    const tileLayer = L.tileLayer(isDark ? darkTile : lightTile, {
      attribution,
      subdomains: 'abcd',
      maxZoom: 19,
    }).addTo(map);

    // theme switch
    const observer = new MutationObserver(() => {
      const dark = document.documentElement.dataset.theme === 'dark';
      tileLayer.setUrl(dark ? darkTile : lightTile);
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    const accent = getComputedStyle(document.body).getPropertyValue('--brand-accent').trim() || '#9b7a32';
    const icon = makeIcon(accent);

    const latlngs = markers.map(m => {
      const marker = L.marker([m.lat, m.lng], { icon }).addTo(map);
      marker.bindPopup(
        `<div class="map-popup">
          <a href="${m.href}" class="map-popup__title">${m.title}</a>
          ${m.location ? `<span class="map-popup__loc">${m.location}</span>` : ''}
        </div>`
      );
      return [m.lat, m.lng];
    });

    if (latlngs.length === 1) {
      map.setView(latlngs[0], 12);
    } else if (latlngs.length > 1) {
      map.fitBounds(L.latLngBounds(latlngs), { padding: [48, 48] });
    } else {
      map.setView([37.5665, 126.9780], 10);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>

<style>
  .map-section {
    margin-top: 2rem;
  }

  .map-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    padding: 0 0 0.6rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }

  .map-label__icon {
    color: var(--brand-accent);
    font-size: 0.75rem;
  }

  .map-label__count {
    margin-left: auto;
    color: var(--brand-accent);
    opacity: 0.7;
  }

  .photo-map {
    width: 100%;
    height: 340px;
    border: 1px solid var(--border);
    border-top: none;
  }

  /* Leaflet 팝업 커스텀 */
  :global(.map-popup) {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-family: var(--font-mono, monospace);
  }

  :global(.map-popup__title) {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
  }

  :global(.map-popup__title:hover) { text-decoration: underline; }

  :global(.map-popup__loc) {
    font-size: 0.7rem;
    color: #666;
  }

  :global(.leaflet-popup-content-wrapper) {
    border-radius: 4px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }

  :global(.leaflet-control-attribution) {
    font-size: 0.55rem !important;
  }
</style>
