---
import TagList from './TagList.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  date?: Date;
  category?: string;
  tags?: string[];
  variant?: 'writing' | 'photo' | 'dev' | 'music';
  meta?: string;
  index?: number;
}

const {
  href,
  title,
  description,
  date,
  category,
  tags = [],
  variant = 'writing',
  meta,
  index,
} = Astro.props;

const formattedDate = date?.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<a href={href} class={`content-card content-card--${variant}`}>
  <div class="content-card__top">
    <span>{index !== undefined ? String(index + 1).padStart(2, '0') : category}</span>
    {formattedDate && <time datetime={date?.toISOString()}>{formattedDate}</time>}
  </div>
  <h2>{title}</h2>
  <p>{description}</p>
  <div class="content-card__bottom">
    {category && <span>{category}</span>}
    {meta && <span>{meta}</span>}
    <TagList tags={tags} />
  </div>
</a>

<style>
  .content-card {
    border-top: 1px solid var(--border);
    color: var(--text-primary);
    display: block;
    padding: 1rem 0;
    text-decoration: none;
  }

  .content-card:hover {
    text-decoration: none;
  }

  .content-card:hover h2 {
    color: var(--brand-accent, var(--cobalt));
  }

  .content-card--writing:hover h2 { color: var(--teal); }
  .content-card--photo:hover h2 { color: var(--gold); }
  .content-card--dev:hover h2 { color: var(--cobalt); }
  .content-card--music:hover h2 { color: var(--crimson); }

  .content-card__top,
  .content-card__bottom {
    align-items: center;
    color: var(--text-tertiary);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.74rem;
    gap: 0.55rem;
  }

  .content-card__top {
    font-family: var(--font-mono);
    justify-content: space-between;
  }

  .content-card h2 {
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 560;
    line-height: 1.3;
    margin: 0.35rem 0;
    transition: color 0.15s;
  }

  .content-card p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }
</style>
