---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  category: 'dev' | 'photo' | 'music' | 'writing' | 'essay';
  body?: string;
}

const { slug, title, description, pubDate, category, body = '' } = Astro.props;

const categoryLabel: Record<string, string> = {
  dev: 'Dev', photo: 'Photo', music: 'Music', writing: 'Writing', essay: 'Essay',
};

const dateStr = pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });

const wordCount = body.replace(/```[\s\S]*?```/g, '').replace(/[#*`>\-\[\]]/g, '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(wordCount / 200));
---

<a href={`/posts/${slug}`} class={`post-card post-card--${category}`}>
  <div class="post-card__top">
    <span class={`badge badge--${category}`}>{categoryLabel[category]}</span>
    <div class="post-card__meta">
      <span class="post-card__read">{readMin}분</span>
      <time class="post-card__date">{dateStr}</time>
    </div>
  </div>
  <h2 class="post-card__title">{title}</h2>
  <p class="post-card__desc">{description}</p>
</a>

<style>
  .post-card {
    display: block;
    padding: 1.1rem 1.25rem;
    border-radius: 10px;
    border: 0.5px solid var(--border);
    background: var(--bg-1);
    transition: border-color 0.15s, background 0.15s;
    text-decoration: none;
  }

  .post-card:hover { text-decoration: none; background: var(--bg-2); }

  .post-card--dev:hover     { border-color: var(--cobalt-light); }
  .post-card--photo:hover   { border-color: var(--gold-light); }
  .post-card--music:hover   { border-color: var(--crimson-light); }
  .post-card--writing:hover { border-color: var(--teal-light); }
  .post-card--essay:hover   { border-color: var(--text-tertiary); }

  .post-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .post-card__meta { display: flex; align-items: center; gap: 0.6rem; }
  .post-card__read { font-size: 0.7rem; color: var(--text-tertiary); }
  .post-card__date { font-size: 0.75rem; color: var(--text-tertiary); }
  .post-card__title { font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.35rem; line-height: 1.4; }
  .post-card__desc { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
