---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { project: CollectionEntry<'projects'>; index: number; }
const { project, index } = Astro.props;
const { title, summary, appUrl } = project.data;
---
<a class="featured-project" href={appUrl ?? `/portfolio/${project.id}/`} target={appUrl ? '_blank' : undefined} rel={appUrl ? 'noopener noreferrer' : undefined}>
  <div class="featured-project-top"><span class="featured-project-icon" aria-hidden="true">{Array.from(title)[0]}</span><span class="mono">{String(index + 1).padStart(2, '0')}</span></div>
  <h3>{title}</h3><p>{summary}</p>
  <span class="featured-project-action">{appUrl ? '앱 열기' : '프로젝트 보기'}<Arrow external={Boolean(appUrl)} /></span>
  {appUrl && <span class="sr-only"> (외부 사이트, 새 탭)</span>}
</a>
