---
interface Props {
  title: string;
  description: string;
  category: 'dev' | 'photo' | 'music';
  tags?: string[];
  href?: string;
  status?: 'done' | 'wip' | 'archived';
}

const { title, description, category, tags = [], href, status = 'done' } = Astro.props;

const statusLabel: Record<string, string> = { done: '완성', wip: '진행 중', archived: '보관' };
const categoryLabel: Record<string, string> = { dev: 'Dev', photo: 'Photo', music: 'Music' };
---

<div class={`work-card work-card--${category}`}>
  <div class="work-card__header">
    <span class={`badge badge--${category}`}>{categoryLabel[category]}</span>
    <span class="work-card__status">{statusLabel[status]}</span>
  </div>
  <h3 class="work-card__title">{title}</h3>
  <p class="work-card__desc">{description}</p>
  {tags.length > 0 && (
    <div class="work-card__tags">
      {tags.map(t => <span class="work-card__tag">{t}</span>)}
    </div>
  )}
  {href && (
    <a href={href} target="_blank" rel="noopener" class="work-card__link">
      보러 가기 ↗
    </a>
  )}
</div>

<style>
  .work-card {
    padding: 1.25rem;
    border-radius: 10px;
    border: 0.5px solid var(--border);
    background: var(--bg-1);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: border-color 0.15s;
  }

  .work-card--dev:hover     { border-color: var(--cobalt-light); }
  .work-card--photo:hover   { border-color: var(--gold-light); }
  .work-card--music:hover   { border-color: var(--crimson-light); }

  .work-card__header { display: flex; align-items: center; justify-content: space-between; }
  .work-card__status { font-size: 0.7rem; color: var(--text-tertiary); }
  .work-card__title { font-size: 1rem; font-weight: 600; color: var(--text-primary); }
  .work-card__desc { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; flex: 1; }

  .work-card__tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .work-card__tag {
    font-size: 0.7rem; padding: 2px 8px; border-radius: 99px;
    background: var(--bg-2); color: var(--text-tertiary);
    border: 0.5px solid var(--border);
  }

  .work-card__link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--cobalt-light);
    margin-top: 0.25rem;
  }
</style>
